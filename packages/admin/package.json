{
  "name": "@festivaldev/nekonexus-admin",
  "version": "0.1.0",
  "description": "NekoNexus admin dashboard (server management, players, store)",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "start": "bun src/index.ts",
    "build:win-x64": "bun build ./src/index.ts --compile --minify --target=bun-windows-x64 --outfile=../../.release/server/_pak/NekoNexus.Admin/NekoNexus.Admin_x64.exe",
    "build:linux-x64": "bun build ./src/index.ts --compile --minify --target=bun-linux-x64 --outfile=../../.release/server/_pak/NekoNexus.Admin/nekonexus-admin-linux-amd64",
    "build:linux-arm64": "bun build ./src/index.ts --compile --minify --target=bun-linux-arm64 --outfile=../../.release/server/_pak/NekoNexus.Admin/nekonexus-admin-linux-arm64"
  },
  "dependencies": {
    "@festivaldev/nekonexus-models": "workspace:*",
    "@festivaldev/uberstrike-js": "workspace:*",
    "bcryptjs": "^2.0.0",
    "mysql2": "^3.0.0",
    "sequelize": "^6.0.0",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.0.0",
    "@types/bun": "latest"
  }
}
