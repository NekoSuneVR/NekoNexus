# Copy this to ".nekopay.env" (git-ignored) next to the admin and fill it in.
# NEVER commit the secret key.

# Your NekoPay STORE SECRET key (from the NekoPay dashboard). Starts with sk_live_…
NEKOPAY_SECRET=

# Public key is safe to expose (optional, shown in the dashboard).
NEKOPAY_PUBLIC_KEY=pk_live_0c1d2e0921ed6c88c9920ff90a2c21a7c84083b57b51144b

# Merchant API endpoint (default is correct for NekoPay).
NEKOPAY_ENDPOINT=https://pay.nekolive.co.uk/api/merchant/checkout-sessions

# The PUBLIC URL NekoPay can reach to deliver webhooks + redirect buyers.
# Must be reachable from the internet (your domain). The webhook is served at
#   <PUBLIC_BASE_URL>/api/webhooks/nekopay
# and you set that as the session notificationUrl automatically.
PUBLIC_BASE_URL=https://your-domain.example

# Optional: override the admin port (default 8088) and token secret.
# ADMIN_PORT=8088
# ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# Optional DB override (otherwise it reads NekoNexus.Settings.WebServices.yml):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=nekonexus
# DB_PASS=nekonexus
# DB_NAME=nekonexus
