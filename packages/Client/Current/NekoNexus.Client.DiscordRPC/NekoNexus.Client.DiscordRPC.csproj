<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Target 4.8 (NOT 4.8.1): the installer guarantees .NET Framework 4.8, but 4.8.1 is a separate
         optional update. An exe targeting 4.8.1 fails to launch on a 4.8-only machine - and since the
         mod starts this helper hidden with no output, that failure was silent (Discord RPC just never
         appeared). 4.8 runs the bundled net45 Discord library fine. -->
    <TargetFramework>net48</TargetFramework>
    <OutputPath>..\..\..\..\.release\client\_pak\UberStrike_Data\Plugins</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateSupportedRuntime>False</GenerateSupportedRuntime>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>none</DebugType>
    <DebugSymbols>False</DebugSymbols>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowedReferenceRelatedFileExtensions>
      <!-- Prevent default XML and PDB files copied to output in RELEASE.
           Only *.allowedextension files will be included, which doesn't exist in my case.
      -->
      .allowedextension
    </AllowedReferenceRelatedFileExtensions>
    <PathMap>
      $([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=C:\buildroot\$(MSBuildProjectName)
    </PathMap>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiscordRichPresence" Version="1.2.1.24" />
    <PackageReference Include="NewtonSoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <EmbeddedResource Include="$(UserProfile)\.nuget\packages\discordrichpresence\1.2.1.24\lib\net45\DiscordRPC.dll">
      <Link>lib\DiscordRPC.dll</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="$(UserProfile)\.nuget\packages\newtonsoft.json\13.0.3\lib\net45\Newtonsoft.Json.dll">
      <Link>lib\Newtonsoft.Json.dll</Link>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <EmbeddedResource Include="$(HOME)\.nuget\packages\discordrichpresence\1.2.1.24\lib\net45\DiscordRPC.dll">
      <Link>lib\DiscordRPC.dll</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="$(HOME)\.nuget\packages\newtonsoft.json\13.0.3\lib\net45\Newtonsoft.Json.dll">
      <Link>lib\Newtonsoft.Json.dll</Link>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PostBuildEvent>
      XCOPY /Y /R /Q "$(MSBuildProjectDirectory)\$(OutputPath)\*.exe" "$(MSBuildProjectDirectory)\..\..\..\ws\wwwroot\updates\v2\beta\win\UberStrike_Data\Plugins\" > nul
    </PostBuildEvent>
  </PropertyGroup>
</Project>
