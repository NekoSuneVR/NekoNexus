<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
	<OutputPath>bin\$(Configuration)</OutputPath>
	<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	<GenerateSupportedRuntime>False</GenerateSupportedRuntime>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
	<DebugSymbols>False</DebugSymbols>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowedReferenceRelatedFileExtensions>
      <!-- Prevent default XML and PDB files copied to output in RELEASE.
           Only *.allowedextension files will be included, which doesn't exist in my case.
      -->
      .allowedextension
	</AllowedReferenceRelatedFileExtensions>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=C:\buildroot\$(MSBuildProjectName)</PathMap>
	<GenerateDocumentationFile>False</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.2.2" />
    <PackageReference Include="log4net" Version="2.0.17" />
    <PackageReference Include="YamlDotNet" Version="13.7.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\..\AssemblyReferences\4.7.1\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>..\..\..\AssemblyReferences\4.7.1\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>..\..\..\AssemblyReferences\4.7.1\Photon3Unity3D.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\..\AssemblyReferences\4.7.1\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="log4net.config" />
    <EmbeddedResource Include="ScreenResolutions.xml" />
    <EmbeddedResource Include="Resources\icon_discord.png" />
    <EmbeddedResource Include="Resources\icon_github.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Paradise.Client.DiscordRPC\IRichPresenceServiceContract.cs">
      <Link>Plugins\RichPresence\IRichPresenceServiceContract.cs</Link>
    </Compile>
  </ItemGroup>

  <PropertyGroup>
	<PreBuildEvent>taskkill /f /im UberStrike.exe 2>nul 1>nul
exit 0</PreBuildEvent>
  </PropertyGroup>

</Project>
