{
  "name": "@festivaldev/nekonexus-webservices",
  "version": "2.1.2-1",
  "author": "Team FESTIVAL <weare@festival.tf>",
  "description": "Provides SOAP web services and assets for UberStrike",
  "homepage": "https://github.com/festivaldev/nekonexus-js",
  "license": "GPL-3.0-only",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "start": "bun src/index.ts",
    "build-all": "NODE_ENV=production bun run build-all:dev",
    "build-all:dev": "bun run build:win-x64 && bun run build:linux-x64 && bun run build:darwin-x64 && bun run build:linux-arm64 && bun run build:darwin-arm64",
    "build:win-x64": "bun build ./src/index.ts --compile --minify --target=bun-windows-x64 --outfile=../../.release/server/_pak/NekoNexus.WebServices/NekoNexus.WebServices_x64.exe",
    "build:linux-x64": "bun build ./src/index.ts --compile --minify --target=bun-linux-x64 --outfile=../../.release/server/_pak/NekoNexus.WebServices/nekonexus-linux-amd64",
    "build:linux-arm64": "bun build ./src/index.ts --compile --minify --target=bun-linux-arm64 --outfile=../../.release/server/_pak/NekoNexus.WebServices/nekonexus-linux-arm64",
    "build:darwin-x64": "bun build ./src/index.ts --compile --minify --target=bun-darwin-x64 --outfile=../../.release/server/_pak/NekoNexus.WebServices/nekonexus-darwin-amd64",
    "build:darwin-arm64": "bun build ./src/index.ts --compile --minify --target=bun-darwin-arm64 --outfile=../../.release/server/_pak/NekoNexus.WebServices/nekonexus-darwin-arm64"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bcryptjs": "^2.0.0",
    "@types/body-parser-xml": "^2.0.0",
    "@types/bun": "latest",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/seedrandom": "^3.0.0",
    "@types/ws": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "pg-hstore": "^2.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@festivaldev/nekonexus-models": "workspace:*",
    "@festivaldev/uberstrike-js": "workspace:*",
    "bcryptjs": "^2.0.0",
    "body-parser": "^1.0.0",
    "body-parser-xml": "^2.0.0",
    "chalk": "^4.0.0",
    "commander": "^12.0.0",
    "discord.js": "^14.0.0",
    "express": "^4.0.0",
    "http-status": "^2.0.0",
    "moment": "^2.0.0",
    "morgan": "^1.0.0",
    "mysql2": "^3.0.0",
    "seedrandom": "^3.0.0",
    "sequelize": "^6.0.0",
    "winston": "^3.0.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.0.0",
    "yaml": "^2.0.0"
  }
}
