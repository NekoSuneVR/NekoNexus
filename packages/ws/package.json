{
  "name": "@festivaldev/paradise-webservices",
  "version": "2.1.2-1",
  "description": "Provides SOAP web services and assets for UberStrike",
  "homepage": "https://github.com/festivaldev/paradise-js",
  "author": "Team FESTIVAL <weare@festival.tf>",
  "license": "GPL-3.0-only",
  "module": "dist/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "build:win-x64": "bun build --compile --minify --sourcemap --target=bun-windows-x64 src/index.ts --outfile build/win-x64/Paradise.WebServices.exe",
    "build:linux-x64": "bun build --compile --minify --target=bun-linux-x64 src/index.ts --outfile build/linux-x64/Paradise.WebServices",
    "build:linux-arm64": "bun build --compile --minify --sourcemap --target=bun-linux-arm64 src/index.ts --outfile build/linux-arm64/Paradise.WebServices",
    "build:darwin-x64": "bun build --compile --minify --sourcemap --target=bun-darwin-x64 src/index.ts --outfile build/darwin-x64/Paradise.WebServices",
    "build:darwin-arm64": "bun build --compile --minify --sourcemap --target=bun-darwin-arm64 src/index.ts --outfile build/darwin-arm64/Paradise.WebServices"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/body-parser-xml": "^2.0.5",
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "@types/seedrandom": "^3.0.8",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "eslint": "8.x",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "pg-hstore": "^2.3.4",
    "prettier": "^3.2.5"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@festivaldev/paradise-models": "workspace:*",
    "@festivaldev/uberstrike-js": "workspace:*",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "body-parser-xml": "^2.0.5",
    "chalk": "4.x",
    "commander": "^12.0.0",
    "discord.js": "^14.14.1",
    "express": "^4.19.2",
    "http-status": "^1.7.4",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "mysql2": "^3.10.1",
    "seedrandom": "^3.0.5",
    "sequelize": "^6.37.3",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.17.0",
    "yaml": "^2.4.2"
  }
}