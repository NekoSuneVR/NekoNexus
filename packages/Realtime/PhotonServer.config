<?xml version="1.0" encoding="utf-8"?>

<Configuration>
	<NekoNexusApplication
		DisplayName="NekoNexus">
		<UDPListeners>
			<!--
				If you're hosting a game server and wish to connect
				to the official NekoNexus Master server, wrap the
				UDPListener for NekoNexus.Realtime.Comm in a comment
				to disable it. Do the same for the Application object below.

				For more details, see https://github.com/SniperGER/wiki_test/wiki/ServerMultiServerSetup.
			-->
			<UDPListener
				IPAddress="0.0.0.0"
				Port="5055"
				OverrideApplication="NekoNexus.Realtime.Comm">
			</UDPListener>

			<UDPListener
				IPAddress="0.0.0.0"
				Port="5155"
				OverrideApplication="NekoNexus.Realtime.Game">
			</UDPListener>
		</UDPListeners>

		<Runtime
			Assembly="PhotonHostRuntime, Culture=neutral"
			Type="PhotonHostRuntime.PhotonDomainManager"
			UnhandledExceptionPolicy="Ignore">
		</Runtime>

		<Applications Default="NekoNexus.Realtime.Game">
			<Application
				Name="NekoNexus.Realtime.Comm"
				BaseDirectory="NekoNexus.Realtime"
				Assembly="NekoNexus.Realtime"
				Type="NekoNexus.Realtime.Server.Comm.CommServerApplication"
				ForceAutoRestart="false">
			</Application>

			<Application
				Name="NekoNexus.Realtime.Game"
				BaseDirectory="NekoNexus.Realtime"
				Assembly="NekoNexus.Realtime"
				Type="NekoNexus.Realtime.Server.Game.GameServerApplication"
				ForceAutoRestart="false">
			</Application>
		</Applications>
	</NekoNexusApplication>
</Configuration>
