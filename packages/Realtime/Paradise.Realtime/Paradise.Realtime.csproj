<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <OutputPath>..\..\..\.release\server\_pak\Paradise.Realtime\bin</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateSupportedRuntime>False</GenerateSupportedRuntime>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>none</DebugType>
    <DebugSymbols>False</DebugSymbols>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowedReferenceRelatedFileExtensions>
      <!-- Prevent default XML and PDB files copied to output in RELEASE.
           Only *.allowedextension files will be included, which doesn't exist in my case.
      -->
      .allowedextension
    </AllowedReferenceRelatedFileExtensions>
    <PathMap>
      $([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=C:\buildroot\$(MSBuildProjectName)
    </PathMap>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ServiceModel" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="2.0.15" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="WebSocketSharp" Version="1.0.3-rc11" />
    <PackageReference Include="YamlDotNet" Version="15.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>..\..\AssemblyReferences\4.7.1\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="ExitGames.Logging.Log4Net">
      <HintPath>..\..\AssemblyReferences\ExitGames.Logging.Log4Net.dll</HintPath>
    </Reference>
    <Reference Include="ExitGamesLibs">
      <HintPath>..\..\AssemblyReferences\ExitGamesLibs.dll</HintPath>
    </Reference>
    <Reference Include="Photon.SocketServer">
      <HintPath>..\..\AssemblyReferences\Photon.SocketServer.dll</HintPath>
    </Reference>
    <Reference Include="PhotonHostRuntimeInterfaces">
      <HintPath>..\..\AssemblyReferences\PhotonHostRuntimeInterfaces.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Cmune\Cmune.dotnet.csproj" />
    <ProjectReference Include="..\..\Core\UberStrike.Core.Types\UberStrike.Core.Types.dotnet.csproj" />
    <ProjectReference Include="..\..\Core\UberStrike.Core\UberStrike.Core.dotnet.csproj" />
    <ProjectReference Include="..\..\Core\UberStrike.DataCenter.Common\UberStrike.DataCenter.Common.dotnet.csproj" />
    <ProjectReference Include="..\..\Core\UberStrike.Realtime.Client\UberStrike.Realtime.Client.dotnet.csproj" />
    <ProjectReference Include="..\..\Core\UberStrike.Realtime.UnitySdk\UberStrike.Realtime.UnitySdk.dotnet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="log4net.config" />
    <None Include="Paradise.Realtime.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\PhotonServer.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>..\photon\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
</Project>
