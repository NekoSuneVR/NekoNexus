<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Self-host launcher that replaces PhotonSocketServer.exe. Reads PhotonServer.config,
    instantiates one NekoNexus application (Comm or Game) per process, binds its UDP
    listener via the free Photon.SocketServer shim, and runs the LiteNetLib event loop.
    No Photon host, no licence, configurable slot count.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>NekoNexus.Realtime.Host</AssemblyName>
    <RootNamespace>NekoNexus.Realtime.Host</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\..\.release\server\_pak\NekoNexus.Realtime\bin</OutputPath>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NekoNexus.Realtime\NekoNexus.Realtime.csproj" />
    <!-- The shim provides ApplicationBase / RealtimeHostOptions used directly here. -->
    <Reference Include="Photon.SocketServer">
      <HintPath>..\..\AssemblyReferences\Photon.SocketServer.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
