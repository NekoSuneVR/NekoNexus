<Project>

  <!--
    Make .NET Framework projects (net2x / net3x / net4x — e.g. the net35 Core SDK and the
    net481 realtime server) compile on ANY OS by pulling the reference assemblies in as a
    NuGet package. This is what lets the Linux Docker build (and Linux CI) `dotnet build`
    these targets. Harmless on Windows (where targeting packs already exist).
    Skipped for net8.0 / netstandard projects.
  -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net2')) Or $(TargetFramework.StartsWith('net3')) Or $(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
