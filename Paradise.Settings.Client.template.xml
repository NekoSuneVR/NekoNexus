<?xml version="1.0" encoding="utf-8"?>
<!--
  Paradise client settings. Drop this into <UberStrike>\UberStrike_Data\ as
  "Paradise.Settings.Client.xml" (Paradise imports it on first launch).

  Replace SERVER_HOST with your server's address (IP or hostname). The web service
  returns the realtime server list, so this single URL is all the client needs.
  After first launch you can add/switch multiple servers in-game via
  Paradise Settings -> Web Service URLs (that list IS your server browser).
-->
<ParadiseClientSettings>
  <EnableDiscordRichPresence>false</EnableDiscordRichPresence>

  <!-- Your Paradise web service. Port 8080 by default; keep the /2.0/ path. -->
  <WebServiceBaseUrl>http://SERVER_HOST:8080/2.0/</WebServiceBaseUrl>
  <WebServicePrefix>UberStrike.DataCenter.WebService.CWS.</WebServicePrefix>
  <WebServiceSuffix>Contract.svc</WebServiceSuffix>

  <!-- File server (images/assets). Port 8081 by default. -->
  <ImagePath>http://SERVER_HOST:8081/images/</ImagePath>

  <!-- Auto-updates ON so players receive your pushed fixes on launch. UpdateChannel can be
       Stable or Beta (players can switch in-game: Paradise Settings -> Updates). Publish updates
       with misc/publish-update.ps1 -Channel stable|beta. -->
  <AutoUpdates>true</AutoUpdates>
  <UpdateChannel>Stable</UpdateChannel>
  <UpdateUrl>http://SERVER_HOST:8081/updates/</UpdateUrl>
</ParadiseClientSettings>
