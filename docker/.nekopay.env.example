# NekoPay config for the admin/store in Docker.
# Copy this to docker/.nekopay.env (git-ignored) and fill in your keys.
# The admin compose service loads it via env_file (required: false).

# Your NekoPay SECRET key — KEEP PRIVATE, never commit. (admin reads this to create checkouts)
NEKOPAY_SECRET=replace-with-your-nekopay-secret-key

# Your NekoPay PUBLIC key — safe to expose to clients.
NEKOPAY_PUBLIC_KEY=replace-with-your-nekopay-public-key

# Merchant checkout endpoint (default is fine).
NEKOPAY_ENDPOINT=https://pay.nekolive.co.uk/api/merchant/checkout-sessions

# Public URL NekoPay can reach for the webhook + return pages. MUST be internet-reachable
# (your domain / tunnel), e.g. https://admin.yourdomain.com — NOT localhost in production.
PUBLIC_BASE_URL=https://admin.yourdomain.com
